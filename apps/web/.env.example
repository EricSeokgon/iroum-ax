# SPEC-AX-WEB-001 Phase A — 환경 변수 (예시)
# 실제 값은 .env.local에 보관(VCS 제외)

# Go control-plane base URL (BFF에서 직접 호출 시 사용)
BACKEND_BASE_URL=http://localhost:8080

# Keycloak OIDC Public Client 설정
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=iroum-ax
KEYCLOAK_CLIENT_ID=iroum-ax-web

# Next.js 자체 URL (callback redirect_uri 구성용)
NEXT_PUBLIC_APP_URL=http://localhost:3000
