# SPEC-AX-E2E-001 — Playwright E2E 테스트 환경 변수 예시
# 실제 사용 시 본 파일을 .env.test 로 복사 후 값을 채워서 사용
# .env.test 는 .gitignore 에 등록되어 있어 커밋되지 않음 (REQ-E2E-NO-301)

# Next.js dev 서버 baseURL
PLAYWRIGHT_BASE_URL=http://localhost:3000

# 모킹 모드 — "mock"(기본, 라이브 백엔드 불필요) 또는 "live" (E2E_LIVE_BACKEND=1 필요)
# OPEN #2: 듀얼 모드, 기본은 page.route 모킹
E2E_MOCK_MODE=mock

# 라이브 백엔드 모드 활성화 — Go control-plane + Postgres + MinIO 가 실행 중이어야 함
# REQ-E2E-OPT-201 best-effort 옵션, EXC-7
# E2E_LIVE_BACKEND=1

# CI 환경 표시 (선택) — 설정 시 .only() 금지 + 재시도 2회 + 워커 1
# CI=1
